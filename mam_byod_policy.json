{
  "@odata.type": "#microsoft.graph.iosManagedAppProtection",
  "displayName": "Zero-Trust: BYOD App Protection Policy (MAM)",
  "description": "Isolates corporate data on personal devices. Enforces PIN, blocks copy/paste to personal apps, and requires OS compliance.",
  "appActionIfDeviceComplianceRequired": "block",
  "appActionIfMaximumPinRetriesExceeded": "wipe",
  "pinRequired": true,
  "maximumPinRetries": 5,
  "allowedDataStorageServices": [
    "sharePoint",
    "oneDriveForBusiness"
  ],
  "clipboardSharingLevel": "managedAppsWithPasteIn",
  "dataBackupBlocked": true,
  "deviceComplianceRequired": true,
  "saveAsBlocked": true,
  "simplePinBlocked": true,
  "minimumRequiredOsVersion": "16.0",
  "apps": [
    {
      "@odata.type": "#microsoft.graph.managedMobileApp",
      "mobileAppIdentifier": "com.microsoft.Office.Outlook"
    },
    {
      "@odata.type": "#microsoft.graph.managedMobileApp",
      "mobileAppIdentifier": "com.microsoft.skype.teams"
    }
  ]
}